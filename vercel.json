{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "regions": [
    "syd1"
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), browsing-topics=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://challenges.cloudflare.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; media-src 'self' data: blob:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self';"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/create-device",
      "destination": "/api/device/create-device"
    },
    {
      "source": "/api/delete-device",
      "destination": "/api/device/delete-device"
    },
    {
      "source": "/api/update-device",
      "destination": "/api/device/update-device"
    },
    {
      "source": "/api/update-device-auth",
      "destination": "/api/device/update-device-auth"
    },
    {
      "source": "/api/scan-pass",
      "destination": "/api/gate/scan-pass"
    },
    {
      "source": "/api/decide-visit",
      "destination": "/api/gate/decide-visit"
    },
    {
      "source": "/api/evidence",
      "destination": "/api/gate/evidence"
    },
    {
      "source": "/api/sync-offline-registration",
      "destination": "/api/gate/sync-offline-registration"
    },
    {
      "source": "/api/create-user",
      "destination": "/api/system/create-user"
    },
    {
      "source": "/api/update-user",
      "destination": "/api/system/update-user"
    },
    {
      "source": "/api/update-settings",
      "destination": "/api/system/update-settings"
    },
    {
      "source": "/api/purge-images",
      "destination": "/api/system/purge-images"
    },
    {
      "source": "/api/reconciliation-items",
      "destination": "/api/system/reconciliation-items"
    },
    {
      "source": "/api/webhooks/resend",
      "destination": "/api/auth/resend-webhook"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/admin/retention-maintenance",
      "schedule": "0 18 * * *"
    }
  ]
}
