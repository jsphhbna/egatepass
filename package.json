{
  "name": "e-gatepass",
  "private": true,
  "version": "1.0.0",
  "description": "EARIST E-GatePass — Smart QR Code-Based Visitor Management System",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:migrations": "vitest run tests/migration-chain-pglite.test.ts",
    "test:contracts": "vitest run tests/architecture-contract.test.ts tests/supabase-migration-static.test.ts",
    "test:e2e": "npm run test:e2e:startup",
    "test:e2e:startup": "npm run build && node scripts/run-startup-e2e.mjs",
    "test:legacy:firebase": "npx firebase-tools@13.10.0 emulators:exec \"vitest run tests/firestore.rules.test.ts\"",
    "test:e2e:legacy": "npx firebase-tools@13.10.0 emulators:exec --only auth,firestore \"playwright test tests/e2e/legacy-baseline.spec.ts\"",
    "test:architecture": "vitest run tests/architecture-contract.test.ts",
    "test:supabase:static": "vitest run tests/supabase-migration-static.test.ts",
    "test:runtime": "vitest run tests/runtime-config.test.ts",
    "test:identity:static": "vitest run tests/identity-migration-static.test.ts",
    "test:issuance:static": "vitest run tests/pass-issuance-static.test.ts",
    "test:lifecycle:static": "vitest run tests/gate-lifecycle-static.test.ts",
    "typecheck:api": "tsc --noEmit --project tsconfig.api.json",
    "typecheck:functions": "tsc --noEmit --project netlify/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsphhbna/egatepass.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jsphhbna/egatepass/issues"
  },
  "homepage": "https://github.com/jsphhbna/egatepass#readme",
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.1",
    "@supabase/supabase-js": "^2.118.0",
    "date-fns": "^4.4.0",
    "firebase": "^12.19.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.49.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "standardwebhooks": "1.1.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@netlify/functions": "^6.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cloudinary": "^2.11.0",
    "firebase-admin": "^14.5.0",
    "happy-dom": "^21.0.4",
    "netlify-cli": "27.10.2",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
