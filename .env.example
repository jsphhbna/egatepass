# E-GatePass environment template. Copy to .env or .env.local, then add local values.
# This file contains names and safe placeholders only. Never commit real credentials.

# PUBLIC FIREBASE CLIENT CONFIG (safe in the browser bundle)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# FIREBASE ADMIN SERVER CONFIG (Netlify Functions only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# CLOUDINARY SERVER CONFIG (Netlify Functions only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# INTERNAL SCHEDULED CLEANUP AUTHORIZATION (server-only secret)
CRON_SECRET=

# BUILD / RUNTIME CONFIGURATION (non-secret; source-controlled in netlify.toml)
AWS_LAMBDA_JS_RUNTIME=nodejs24.x
NODE_OPTIONS=--experimental-require-module

# DEVELOPMENT ONLY (never set emulator hosts for production)
VITE_USE_FIREBASE_EMULATORS=false
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=
GCLOUD_PROJECT=
